{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "./src/db/**/*.ts",
        "./src/db/schema/**/*.ts",
        "./src/schemas/**/*.ts"
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off",
            "organizeImports": "on"
          }
        }
      }
    }
  ]
}
